apiVersion: apps/v1
kind: Deployment
metadata:
  name: postgres-deploy
  labels:
    app: postgres
spec:
  replicas: 1
  selector:
    matchLabels:
      app: postgres
  template:
    metadata:
      labels:
        app: postgres
    spec:
      initContainers:
      - name: init-postgres-1
        image: busybox
        command:
          [
            "sh",
            "-c",
            "mkdir -p /var/lib/postgresql/data && dd if=/dev/urandom of=/var/lib/postgresql/data/testfile bs=1M count=5120",
          ]
        volumeMounts:
        - name: postgres-portworx-1
          mountPath: /var/lib/postgresql/data
      - name: init-postgres-2
        image: busybox
        command:
          [
            "sh",
            "-c",
            "mkdir -p /var/lib/postgresql/data2 && dd if=/dev/urandom of=/var/lib/postgresql/data2/testfile bs=1M count=512000",
          ]
        volumeMounts:
        - name: postgres-portworx-2
          mountPath: /var/lib/postgresql/data2
      containers:
      - name: postgres
        image: postgres:13
        env:
        - name: POSTGRES_PASSWORD
          value: postgrespassword
        - name: PGDATA
          value: /var/lib/postgresql/data/pgdata
        volumeMounts:
        - name: postgres-portworx-1
          mountPath: /var/lib/postgresql/data
        - name: postgres-portworx-2
          mountPath: /var/lib/postgresql/data2
      volumes:
      - name: postgres-portworx-1
        persistentVolumeClaim:
          claimName: postgres-portworx-pvc-1
      - name: postgres-portworx-2
        persistentVolumeClaim:
          claimName: postgres-portworx-pvc-2

